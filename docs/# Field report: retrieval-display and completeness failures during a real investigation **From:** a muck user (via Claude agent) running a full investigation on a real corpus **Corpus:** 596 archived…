_SENT_BREAK = re.compile(r"(?<=[.!?])\s+|(?:\r?\n){2,}")
_WORD = re.compile(r"[\w'-]{3,}")


def _best_window(text: str, query: str, qvec=None, emb=None, width: int = 220) -> str:
    """Query-relevant snippet: a window around the sentence most relevant to the query.

    Scores sentences by cosine against the query vector when an embedder is in hand
    (vector-leg hits have no FTS5 snippet), else by content-word overlap. Falls back to
    the chunk head when nothing scores.
    """
    head = text[:width].strip() + ("…" if len(text) > width else "")
    spans, start = [], 0
    for m in _SENT_BREAK.finditer(text):
        if text[start : m.start()].strip():
            spans.append((start, m.start()))
        start = m.end()
    if text[start:].strip():
        spans.append((start, len(text)))
    if len(spans) < 2 or not query:
        return head

    if emb is not None and qvec is not None:
        sims = (emb.embed([text[s:e].strip() for s, e in spans]) @ qvec).tolist()
        best = max(range(len(sims)), key=sims.__getitem__)
    else:
        terms = set(_WORD.findall(query.lower()))
        overlaps = [len(terms & set(_WORD.findall(text[s:e].lower()))) for s, e in spans]
        best = max(range(len(overlaps)), key=overlaps.__getitem__)
        if overlaps[best] == 0:
            return head

    s, e = spans[best]
    if e - s >= width:
        lo, hi = s, s + width
    else:
        lo = max(0, s - (width - (e - s)) // 2)
        hi = min(len(text), lo + width)
        lo = max(0, hi - width)
    return ("…" if lo else "") + text[lo:hi].strip() + ("…" if hi < len(text) else "")


